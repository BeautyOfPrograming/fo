<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="#6FE6E6E6"
    android:gravity="center">


    <RelativeLayout
        android:layout_width="200dp"
        android:layout_height="320dp"
        android:padding="@dimen/_3sdp"
        android:id="@+id/container_me"

        >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_70sdp"
            android:background="@drawable/rectangle"

            />

        <ImageView
            android:id="@+id/id_product_image"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_120sdp"
            android:src="@drawable/pizza1" />

        <TextView

            android:id="@+id/id_product_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/id_product_image"
            android:layout_alignParentRight="true"

            android:paddingRight="10dp"
            android:text=" پیتزا"
            android:textSize="@dimen/_18sdp"
            android:textStyle="bold|italic" />

        <TextView
            android:id="@+id/id_product_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/id_product_name"
            android:layout_alignParentRight="true"
            android:paddingRight="@dimen/_10sdp"
            android:text="خوش بو ، با طمع خاص"
            android:textSize="@dimen/_13sdp"
            android:textStyle="italic" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/id_product_description">

            <ImageView
                android:id="@+id/id_product_add_tocard"
                android:layout_width="@dimen/_45sdp"
                android:layout_height="@dimen/_45sdp"
                android:layout_alignParentLeft="true"
                android:layout_marginTop="10dp"
                android:background="@drawable/circle"
                android:padding="6dp"
                android:src="@drawable/shopping" />

            <TextView
                android:id="@+id/id_product_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_marginTop="10dp"
                android:padding="10dp"
                android:text=" 45 هزار تومان"
                android:textSize="@dimen/_15sdp"
                android:textStyle="italic|bold"

                />


        </RelativeLayout>


    </RelativeLayout>
</RelativeLayout>